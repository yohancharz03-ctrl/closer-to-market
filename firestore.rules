rules_version = '2';
// HALI YA MAJARIBIO (mpango wa bure). Si kwa pesa halisi - tumia firestore.production.rules ukihamia Blaze.
service cloud.firestore { match /databases/{db}/documents {
  function signed() { return request.auth != null; }
  function adminEmail() { return exists(/databases/$(db)/documents/config/admin) ? get(/databases/$(db)/documents/config/admin).data.email : 'ctm2026@gmail.com'; }
  function isAdminEmail() { return signed() && request.auth.token.email.lower() == adminEmail(); }
  function isAdmin() { return signed() && exists(/databases/$(db)/documents/accounts/$(request.auth.uid)) && get(/databases/$(db)/documents/accounts/$(request.auth.uid)).data.role == 'admin'; }
  match /accounts/{uid} {
    allow read: if signed() || resource.data.role in ['vendor','dalali'];
    allow create: if (signed() && request.auth.uid == uid && request.resource.data.role in ['customer','vendor','dalali']) || (isAdminEmail() && request.auth.uid == uid) || isAdmin();
    allow update: if isAdmin() || isAdminEmail() || (signed() && request.resource.data.role == resource.data.role && request.resource.data.uid == resource.data.uid);
    allow delete: if isAdmin();
  }
  match /presence/{id} { allow read: if true; allow write: if request.auth != null; }
  match /config/{id} { allow read: if signed(); allow write: if isAdmin(); }
  match /invites/{code} { allow get: if true; allow list, write: if signed(); }
  match /{col}/{id} {
    allow read: if col in ['products','reels','stories','lives','offers','reviews'] || signed();
    allow write: if signed() && col != 'accounts' && col != 'config';
  }
} }
